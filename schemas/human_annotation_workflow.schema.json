{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm_job_evaluation/human_annotation_workflow.schema.json",
  "title": "Blind human annotation submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eval_id", "reviewer", "confirm", "annotation", "annotation_notes"],
  "properties": {
    "eval_id": {"type": "string", "pattern": "^eval-v1-[0-9]{3}$"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 120},
    "confirm": {"type": "boolean"},
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience", "required_skills", "preferred_skills", "rtw", "seniority", "hard_blockers", "final_recommendation"],
      "properties": {
        "experience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_years", "max_years", "requirement_level", "domain_specific_or_generic", "domain", "responsibility_scope"],
          "properties": {
            "min_years": {"oneOf": [{"type": "number", "minimum": 0}, {"enum": ["unknown", "not stated", "none"]}]},
            "max_years": {"oneOf": [{"type": "number", "minimum": 0}, {"enum": ["unknown", "not stated", "none"]}]},
            "requirement_level": {"enum": ["essential", "desirable", "unknown", "not stated", "none"]},
            "domain_specific_or_generic": {"enum": ["domain-specific", "generic", "unknown", "not stated", "none"]},
            "domain": {"type": "string", "minLength": 1, "maxLength": 240},
            "responsibility_scope": {"enum": ["entry_level", "individual_contributor", "independent_ownership", "management", "senior_specialist", "unknown", "not stated", "none"]}
          }
        },
        "required_skills": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 180}, "minItems": 1, "uniqueItems": true},
        "preferred_skills": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 180}, "minItems": 1, "uniqueItems": true},
        "rtw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_authorization_wording", "sponsorship_wording", "sponsorship_status", "permanent_or_indefinite_rtw_requirement", "citizenship", "residency", "clearance"],
          "properties": {
            "work_authorization_wording": {"type": "string", "minLength": 1, "maxLength": 600},
            "sponsorship_wording": {"type": "string", "minLength": 1, "maxLength": 600},
            "sponsorship_status": {"enum": ["no_sponsorship", "sponsorship_available", "conditional", "not stated", "unknown", "none"]},
            "permanent_or_indefinite_rtw_requirement": {"enum": ["required", "not required", "not stated", "unknown", "none"]},
            "citizenship": {"type": "string", "minLength": 1, "maxLength": 240},
            "residency": {"type": "string", "minLength": 1, "maxLength": 240},
            "clearance": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        },
        "seniority": {"enum": ["graduate", "entry", "junior", "mid", "senior", "unknown", "not stated", "none"]},
        "hard_blockers": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 240}, "minItems": 1, "uniqueItems": true},
        "final_recommendation": {"enum": ["priority", "apply", "stretch", "ask_hr", "hold", "skip", "unknown", "not stated", "none"]}
      }
    },
    "annotation_notes": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
